# Server-only. Never prefix secrets with NEXT_PUBLIC_. Restart after changes.
AI_CHAT_ENABLED=false
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: openssl rand -hex 32
CHAT_IDENTITY_SECRET=
CHAT_ALLOWED_ORIGIN=http://localhost:3002
# Only set if your hosting proxy OVERWRITES this header. Otherwise shared quota.
CHAT_TRUSTED_IP_HEADER=
# One cent reserved per model call. Default 100 calls/day; 1000 calls total.
CHAT_DAILY_BUDGET_CENTS=100
CHAT_TOTAL_BUDGET_CENTS=1000
